# ── Required ──────────────────────────────────────────────────────────────────

# Apify API token — https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Content ────────────────────────────────────────────────────────────────────

# Comma-separated keywords (defaults to "Claude,AI,Product Design")
KEYWORDS=Claude,AI,Product Design

# Article style: "listicle" (600–900 words) or "explainer" (700–1000 words)
ARTICLE_STYLE=listicle

# Tweets to fetch per keyword
TWEETS_PER_KEYWORD=30

# ── Images (optional but recommended) ─────────────────────────────────────────

# Unsplash API access key — https://unsplash.com/developers
# Free tier: 50 requests/hour — plenty for weekly generation
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ── Web push notifications ─────────────────────────────────────────────────────

# VAPID keys — auto-generated on first run, printed to console
# Paste here so they survive redeploys on Railway
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@adora.so

# ── Server ─────────────────────────────────────────────────────────────────────

PORT=3000
OUTPUT_DIR=output
