# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — get yours at https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of keywords/topics to research
KEYWORDS=AI agents,open source LLMs,prompt engineering

# Article style: "listicle" (600–900 words) or "explainer" (700–1000 words)
ARTICLE_STYLE=listicle

# Number of tweets to fetch per keyword (default: 30)
TWEETS_PER_KEYWORD=30

# Output directory for generated articles (default: ./output)
OUTPUT_DIR=output
